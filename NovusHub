-- محرك السرعة الخارقة وتتبع البيض الساقط الفعلي (God Speed Engine)
-------------------------------------------------------------------
RunService.Heartbeat:Connect(function()
    pcall(function()
        local closestEgg = nil
        local shortestDist = math.huge
        local eggsCount = 0

        -- رصد البيض الموجود في الماب وتحديد البيضة الأقرب أو الساقطة
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name:lower():find("egg") then
                eggsCount = eggsCount + 1
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = LocalPlayer.Character.HumanoidRootPart
                    local targetPart = obj:IsA("Model") and obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if targetPart then
                        local dist = (hrp.Position - targetPart.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestEgg = targetPart
                        end
                    end
                end
            end
        end

        DataDisplay.Text = "📊 رصد البيض: (" .. eggsCount .. ") بيضة بالماب | أقرب هدف مسجل."

        -- تطبيق السرعة الخارقة وتوجيه الشخصية نحو البيضة فوراً عند تفعيل الفارم
        if isGodFarming and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local humanoid = LocalPlayer.Character:FindFirstChild("Humanoid")
            local hrp = LocalPlayer.Character.HumanoidRootPart
            if humanoid then
                humanoid.WalkSpeed = 55 -- سرعة خارقة تتجاوز حركة وتتبع الوحوش تماماً
            end
            if closestEgg and shortestDist > 4 then
                -- توجه سلس وفائق السرعة نحو البيضة الساقطة أو المرسبنة
                hrp.CFrame = hrp.CFrame:Lerp(CFrame.new(closestEgg.Position + Vector3.new(0, 3, 0)), 0.15)
            end
        end
    end)
end)

