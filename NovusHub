-- 3. سيرفر هوب حقيقي (يبحث عن سيرفر بـ شخص واحد أو أقل عدد)
HopBtn.MouseButton1Click:Connect(function()
    StatusBar.Text = "الحالة: جاري البحث عن سيرفر هادئ (شخص واحد)..."
    
    local success, err = pcall(function()
        local servers = {}
        local cursor = ""
        
        repeat
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100" .. (cursor ~= "" and "&cursor=" .. cursor or "")
            local response = HttpService:JSONDecode(game:HttpGet(url))
            cursor = response.nextPageCursor
            for _, server in ipairs(response.data) do
                if server.playing and server.playing < server.maxPlayers and server.id ~= game.JobId then
                    table.insert(servers, server)
                end
            end
        until not cursor or #servers > 0
        
        if #servers > 0 then
            -- ترتيب السيرفرات لأخذ أقل سيرفر فيه لاعبين (مثل شخص واحد)
            table.sort(servers, function(a, b) return a.playing < b.playing end)
            StatusBar.Text = "الحالة: تم العثور على سيرفر هادئ، جاري النقل..."
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[1].id, LocalPlayer)
        else
            StatusBar.Text = "الحالة: لم يتم العثور على سيرفر فارغ، جاري إعادة المحاولة..."
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)
    
    if not success then
        -- حل احتياطي سريع لو حدث خطأ في جلب السيرفرات
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    end
end)

