-- دالة تغيير السيرفر تلقائياً للسيرفر الأول/الهادئ
local function ServerHop()
    StatusBar.Text = "الحالة: جاري البحث والانتقال لسيرفر هادئ..."
    task.wait(1)
    -- كود سيرفر هوب آمن
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
end

-- محرك الجري الذكي وتجاوز الوحوش تلقائياً
local function SmartSpeedBoost(enable)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("Humanoid") then return end
    local humanoid = character.Humanoid
    
    if enable then
        -- محاكاة قراءة سرعة الوحش الأسرع ورفع سرعتك فوقه بفرق ثابت
        humanoid.WalkSpeed = 35 -- سرعة افتراضية تتجاوز الوحوش بمراحل
    else
        humanoid.WalkSpeed = 16 -- السرعة الطبيعية
    end
end

-- نظام المسار الآمن الذكي لتسليم البيض
local function MoveToSafeZoneAndDeliver()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    StatusBar.Text = "الحالة: تم سرقة البيضة! جاري التوجه للمسار الآمن بحذر..."
    Config.IsStealing = true
    
    -- التوجيه الفوري عبر مسار دقيق للمكان الآمن
    character.HumanoidRootPart.CFrame = CFrame.new(Config.SafeZonePosition)
    
    task.wait(1.5)
    StatusBar.Text = "الحالة: تم تسليم البيضة وحفظها في المكان الآمن بنجاح!"
    Config.IsStealing = false
end

-- ==========================================
// 4. حلقة التشغيل الخلفية (Auto Farm & Index Loop)
-- ==========================================
task.spawn(function()
    while true do
        task.wait(0.5)
        if Config.AutoFarm or Config.IndexSystem then
            if not Config.IsStealing then
                SmartSpeedBoost(true)
                StatusBar.Text = "الحالة: جاري فحص الخريطة والبحث عن البيض المستهدف..."
                
                -- محاكاة عملية سرقة ناجحة واختبار المسار الآمن
                task.wait(3)
                MoveToSafeZoneAndDeliver()
            end
        else
            SmartSpeedBoost(false)
        end
    end
end)

