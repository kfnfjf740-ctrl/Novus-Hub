HopBtn.MouseButton1Click:Connect(function()
    StatusLabel.Text = "الحالة: جارِ البحث عن سيرفر هادئ ونظيف..."
    pcall(function()
        local servers = {}
        local req = game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=10")
        local data = game:GetService("HttpService"):JSONDecode(req)
        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing and s.playing < (s.maxPlayers or 20) and s.id ~= game.JobId then
                    table.insert(servers, s.id)
                end
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
        else
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    end)
end)

