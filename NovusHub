-- تفعيل الزر
BuyBtn.MouseButton1Click:Connect(function()
    local amount = TextBox.Text
    if amount == "" then
        amount = "99999"
    end
    
    RobuxDisplay.Text = "رصيدك الحالي الوهمي: " .. amount .. " Robux 💎"
    StatusLabel.Text = "✅ تم تفعيل الرصيد والشراء الوهمي بنجاح!"
    
    task.wait(2)
    StatusLabel.Text = "الحالة: يمكنك الآن استعراض العناصر!"
end)

