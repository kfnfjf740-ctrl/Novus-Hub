-- دالة لعناصر المتجر الوهمي التي تختبر "الشراء"
local currentFakeRobux = 50000
local function createFakeBuyItem(posY, itemName, price)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 50)
    btn.Position = UDim2.new(0, 10, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(32, 32, 48)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize, btn.Font = 12, Enum.Font.GothamBold
    btn.Text = itemName .. " | السعر: " .. price .. " R$"
    btn.Parent = MainFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    btn.MouseButton1Click:Connect(function()
        if currentFakeRobux >= price then
            currentFakeRobux = currentFakeRobux - price
            RobuxDisplay.Text = "رصيدك الوهمي الحالي: " .. currentFakeRobux .. " Robux 💎"
            Status.Text = "🎉 تم شراء (" .. itemName .. ") وهمياً بنجاح!"
            task.wait(1.5)
            Status.Text = "الحالة: جاهز لعملية شراء وهمية أخرى..."
        else
            Status.Text = "❌ رصيدك الوهمي لا يكفي، أعد تعبئته!"
        end
    end)
    return btn
end

